#include <iostream>
#include<algorithm>
#include<vector>
using namespace std;


vector<int> rmvduplicates(int arr[],int n){

    vector <int>vec(arr,arr+n);
    sort(vec.begin(),vec.end());

    auto last =unique(vec.begin(),vec.end());

    vec.erase(last,vec.end());

    return vec;
}

int main(){
    int arr[]={3, 5, 7, 2, 8, 3, 2, 3, 8};
    int n=sizeof(arr)/sizeof(arr[0]);
    vector<int> vec=rmvduplicates(arr,n);
    cout<<"The array is :";
    for(int i=0;i<2;i++){
        cout<<vec[i]<<",";
    }
    cout<<endl;
    return 0;